{
  "name": "@wails-installer/svelte",
  "version": "0.2.0",
  "description": "Customizable Svelte installer UI for the wails-installer Go library",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": [
    "**/*.svelte",
    "**/*.css"
  ],
  "scripts": {
    "build": "svelte-package",
    "prepack": "npm run build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "dev": "vite --host 127.0.0.1",
    "build:demo": "vite build"
  },
  "peerDependencies": {
    "svelte": "^4.2.0 || ^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.4"
  }
}
